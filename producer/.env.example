# Copy to .env and fill with values from Terraform outputs or GitHub Secrets.
# Never commit .env (it is in .gitignore).

# NGINX Load Balancer address (Producer connects here over TLS on port 8082)
BOOTSTRAP_SERVERS=

# Optional: Kafka TLS (SASL_SSL through NGINX passthrough). Broker cert is Confluent's; use OS CA bundle if handshake fails.
# KAFKA_SSL_CA_LOCATION: path to CA bundle (e.g. /etc/ssl/certs/ca-certificates.crt on Ubuntu/WSL).
# KAFKA_SSL_VERIFY_HOSTNAME: set to "false" when BOOTSTRAP_SERVERS is an IP (avoids hostname mismatch; keeps CA verification on). When false, the client sets ssl.endpoint.identification.algorithm=none (librdkafka rejects empty string).
KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_VERIFY_HOSTNAME=true

# Confluent Schema Registry (HTTPS); use NGINX URL when SR goes through proxy (e.g. https://nginx-schema-registry:8443)
SCHEMA_REGISTRY_URL=

# Path to NGINX self-signed CA cert for Schema Registry (required when SCHEMA_REGISTRY_URL uses NGINX :8443).
# Cert is exported from Kubernetes secret nginx-sr-tls. Example export:
#   kubectl get secret nginx-sr-tls -n cjackson-nginx -o jsonpath='{.data.cert\.pem}' | base64 -d > ~/nginx-sr-cert.pem
# Set to the path of the PEM file (e.g. ~/nginx-sr-cert.pem).
SCHEMA_REGISTRY_CA_CERT=

# Optional: dedicated Schema Registry API key/secret. When both are set, the producer uses them for SR basic auth
# (avoids 401 when SR is via NGINX; Confluent Cloud requires a dedicated SR key, not the Kafka key).
# From Terraform: terraform -chdir=terraform output -raw schema_registry_api_key_id (and schema_registry_api_key_secret).
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# Confluent Cloud Kafka API key (from Terraform/Confluent; store in GitHub Secrets)
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Topic name (e.g. cjackson-sample-topic)
TOPIC=

# Optional: set to "false" to disable TLS (not recommended)
SSL_ENABLED=true
